# Copy to .env on the VPS. Never commit the real file.

# Token the HUD sends as: Authorization: Bearer <this>
SOVI_TOKEN=change-me-to-a-long-random-string

# Bind address for the gateway process
PORT=8787
HOST=0.0.0.0

# Public HTTPS URL you will paste into the HUD LINK panel
PUBLIC_BASE_URL=https://sovi.yourdomain.com

# Your existing OpenAI-compatible LLM. Leave blank to use the onboard fallback brain.
# Examples: http://127.0.0.1:11434/v1   http://127.0.0.1:8000/v1   https://api.openai.com/v1
UPSTREAM_URL=
UPSTREAM_KEY=
UPSTREAM_MODEL=sovi

# 0 = log commands only (safe). 1 = run hooks/command.mjs
SOVI_EXECUTE=0
